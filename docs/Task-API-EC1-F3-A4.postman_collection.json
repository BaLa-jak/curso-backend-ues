{
  "info": {
    "name": "Task API - EC1 F3 A4",
    "description": "Colección de pruebas para la API de gestión de tareas con validación, middleware y manejo centralizado de errores (EC1 F3 A4). Incluye el flujo principal, las pruebas negativas del contrato de errores (400, 404, 415, 422, 500) y el desafío individual PATCH /api/tasks/:id/status.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "taskId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Flujo principal",
      "item": [
        {
          "name": "1. GET /api/tasks - Lista inicial",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Responde un arreglo data', () => Array.isArray(pm.response.json().data));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tasks"
              ]
            }
          },
          "response": []
        },
        {
          "name": "2. POST /api/tasks - Crear una tarea",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Devuelve la tarea creada', () => body.data && body.data.title === 'Documentar mi primera API');",
                  "pm.collectionVariables.set('taskId', body.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Documentar mi primera API\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tasks"
              ]
            }
          },
          "response": []
        },
        {
          "name": "3. GET /api/tasks/:id - Consultar la tarea creada",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('id coincide con taskId', () => pm.response.json().data.id === pm.collectionVariables.get('taskId'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tasks",
                "{{taskId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "4. PATCH /api/tasks/:id/complete - Completar la tarea",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('status pasa a completed', () => pm.response.json().data.status === 'completed');",
                  "pm.test('Header X-Request-Id presente', () => pm.response.headers.has('X-Request-Id'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskId}}/complete",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tasks",
                "{{taskId}}",
                "complete"
              ]
            }
          },
          "response": []
        },
        {
          "name": "5. PATCH /api/tasks/:id - Editar título (regresión)",
