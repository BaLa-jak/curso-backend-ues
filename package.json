{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "check": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "build": "tsc",
    "start": "node dist/server.js",
    "role:set": "tsx src/scripts/set-user-role.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "client:dev": "pnpm --dir client dev",
    "client:check": "pnpm --dir client check",
    "client:build": "pnpm --dir client build",
    "verify": "pnpm check && pnpm test && pnpm build && pnpm client:check && pnpm client:build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.24.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.24.0",
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "prettier": "^3.9.6",
    "supertest": "7.3.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "5.0.4"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "mongoose": "^8.24.4",
    "swagger-ui-express": "5.0.1"
  }
}
